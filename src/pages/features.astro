---
import BaseLayout from "../layouts/BaseLayout.astro";
import { product } from "../data/product";

const groups = [
  {
    eyebrow: "Learn",
    heading: "A 6-module roadmap, not a flat question dump",
    items: [
      "30 lessons across 6 modules — Duolingo-style linear progression so you always know what's next",
      "Bilingual lesson content: study in your native language with English alongside, or single-language",
      "Lesson quizzes (6 questions each) with instant feedback and error explanations",
      "Module tests at the end of each module — a milestone check before moving on",
      "Built-in viewer for the official state DMV Driver Handbook",
    ],
  },
  {
    eyebrow: "Practice",
    heading: "Drill the way you'll actually be tested",
    items: [
      "3 full mock exams per state, sized to match the real test (CA 46, IL 35, TX 30 questions)",
      "Wrong Answer Journal — automatic spaced-repetition review of every question you missed",
      "Tricky Questions — a curated set of high-difficulty items that trip most people up",
      "Saved Questions — bookmark anything you want to revisit",
      "Random Practice mode for warm-ups",
    ],
  },
  {
    eyebrow: "Track",
    heading: "Know where you stand before test day",
    items: [
      "Overall accuracy and first-attempt accuracy",
      "Mock exam pass rate and weekly improvement trend",
      "Estimated score vs. your state's passing threshold",
      "Honest pass-chance percentage — so you don't book the appointment too early",
    ],
  },
];
---

<BaseLayout
  title="Features"
  description={`What ${product.name} does — practice tests, smart review, multi-language support, and offline study.`}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-8">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900">
      Built for the test, not for engagement metrics
    </h1>
    <p class="mt-4 text-lg text-slate-600 leading-relaxed">
      Every feature in {product.name} exists to help you pass the DMV permit test the first time.
      No streaks designed to keep you scrolling, no XP loops, no fake difficulty curves.
    </p>
  </section>

  {
    groups.map((g) => (
      <section class="mx-auto max-w-3xl px-6 py-10 border-t border-slate-200">
        <p class="text-sm font-semibold text-indigo-700 uppercase tracking-wide">{g.eyebrow}</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">{g.heading}</h2>
        <ul class="mt-6 space-y-3">
          {g.items.map((item) => (
            <li class="flex gap-3 text-slate-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="mx-auto max-w-3xl px-6 py-10 border-t border-slate-200">
    <p class="text-sm font-semibold text-indigo-700 uppercase tracking-wide">Pricing</p>
    <h2 class="mt-2 text-2xl font-semibold text-slate-900">Free to start, Pro when you're serious</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-base font-semibold text-slate-900">Free</p>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">{product.subscription.free}</p>
      </div>
      <div class="rounded-lg border border-indigo-200 bg-indigo-50/50 p-6">
        <p class="text-base font-semibold text-slate-900">{product.name} Pro</p>
        <p class="mt-2 text-sm text-slate-700 leading-relaxed">{product.subscription.pro}</p>
        <p class="mt-3 text-xs text-slate-500">
          {product.subscription.plans.join(" or ")} · billed through {product.subscription.billedThrough}
        </p>
      </div>
    </div>
    <p class="mt-4 text-sm text-slate-500">
      Pricing is set per storefront and may vary by region. See current prices in the app at checkout.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10 border-t border-slate-200">
    <p class="text-sm font-semibold text-indigo-700 uppercase tracking-wide">Languages &amp; states</p>
    <h2 class="mt-2 text-2xl font-semibold text-slate-900">Where {product.name} works at launch</h2>
    <p class="mt-4 text-slate-600 leading-relaxed">
      Launching with{" "}
      {product.states.map((s, i) => (
        <span>
          <strong class="text-slate-900">{s.name}</strong>
          {i < product.states.length - 1 ? ", " : ""}
        </span>
      ))}.
    </p>
    <p class="mt-3 text-slate-600 leading-relaxed">
      Available in {product.languages.join(", ")}. Each state's exam-language coverage matches what
      that state's DMV actually offers — we don't promise you a Vietnamese test in a state that
      doesn't give one.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12 text-center border-t border-slate-200">
    <p class="text-slate-600">Want to be first to try it?</p>
    <a
      href={`mailto:${product.emails.hello}?subject=Notify%20me%20when%20Permitly%20launches`}
      class="mt-4 inline-flex items-center rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-indigo-500 transition-colors"
      >Notify me at launch →</a
    >
  </section>
</BaseLayout>
