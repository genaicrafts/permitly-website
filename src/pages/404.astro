---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist.">
  <section class="mx-auto max-w-2xl px-6 pt-24 pb-32 text-center">
    <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">Page not found</h1>
    <p class="mt-4 text-slate-600 leading-relaxed">
      The page you were looking for doesn't exist, or it may have moved.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-indigo-500 transition-colors"
        >Go home</a
      >
      <a
        href="/support"
        class="inline-flex items-center rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
        >Get support</a
      >
    </div>
  </section>
</BaseLayout>
