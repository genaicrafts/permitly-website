---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import appRoadmap from "../assets/app-roadmap-en.png";
import StoreBadges from "../components/StoreBadges.astro";
import { product } from "../data/product";

const highlights = [
  {
    title: "Exam-style practice",
    body: "Multiple-choice practice questions organized around driver-handbook topics — not generic flashcards.",
  },
  {
    title: "Ten languages",
    body: `Study in ${product.languages.join(", ")}. Exam language options vary by state — check with your state's DMV.`,
  },
  {
    title: "Works offline",
    body: "Download your state once, then study anywhere — no signal, no battery drain from streaming.",
  },
];
---

<BaseLayout title={product.name} fullTitle={product.seoTitle} description={product.description}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 md:pt-24 md:pb-16">
    <span
      class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-800 px-3 py-1 text-xs font-medium"
    >
      {product.status}
    </span>
    <h1 class="mt-4 text-4xl md:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
      {product.tagline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600 leading-relaxed">
      {product.description}
    </p>
    <StoreBadges class="mt-8" />
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/features"
        class="inline-flex items-center rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
        >See features</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-12">
    <div class="grid gap-6 md:grid-cols-3">
      {
        highlights.map((h) => (
          <div class="rounded-lg border border-slate-200 bg-white p-6">
            <h2 class="text-base font-semibold text-slate-900">{h.title}</h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{h.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16 md:pb-20">
    <div
      class="rounded-2xl border border-slate-200 bg-gradient-to-br from-indigo-50 via-white to-violet-50 p-8 md:p-12"
    >
      <div class="grid gap-8 md:grid-cols-2 items-center">
        <div>
          <p class="text-sm font-medium text-indigo-700 uppercase tracking-wide">State coverage</p>
          <p class="mt-3 text-2xl font-semibold text-slate-900">
            {product.coverageLabel}
          </p>
          <p class="mt-2 text-slate-600 leading-relaxed">
            Choose your state during setup and get practice organized around that jurisdiction's
            permit-test format, handbook topics, passing score, and language options.
          </p>
          <p class="mt-4 text-sm text-slate-500">
            Permitly is independent and is not affiliated with any state DMV.
          </p>
        </div>
        <Image
          src={appRoadmap}
          alt={`${product.name} app showing the lesson roadmap screen`}
          widths={[210, 420, 630]}
          sizes="210px"
          class="mx-auto w-full max-w-[210px] h-auto rounded-3xl border-2 border-slate-200 shadow-sm"
        />
      </div>
    </div>
  </section>
</BaseLayout>
