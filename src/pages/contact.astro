---
import BaseLayout from "../layouts/BaseLayout.astro";
import { product } from "../data/product";
import { company } from "../data/company";

const contactRows = [
  { label: "General questions", email: product.emails.hello },
  { label: "Customer support", email: product.emails.support },
  { label: "Privacy & data requests", email: product.emails.privacy },
  { label: "Legal & business", email: company.emails.legal },
];
---

<BaseLayout
  title="Contact"
  description={`Contact ${product.name} — operated by ${company.legalName}.`}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Contact</h1>
    <p class="mt-3 text-lg text-slate-600">
      Pick the inbox that fits — it helps us route faster. We respond within 2 business days.
    </p>

    <div class="mt-10 rounded-lg border border-slate-200 overflow-hidden">
      <table class="w-full text-sm">
        <tbody class="divide-y divide-slate-200">
          {
            contactRows.map((row) => (
              <tr class="hover:bg-slate-50">
                <th
                  scope="row"
                  class="px-4 py-3 text-left font-medium text-slate-700 w-1/2 align-top"
                >
                  {row.label}
                </th>
                <td class="px-4 py-3 align-top">
                  <a
                    class="text-slate-900 hover:underline font-mono text-sm"
                    href={`mailto:${row.email}`}
                  >
                    {row.email}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-slate-900">Mailing address</h2>
        <address class="not-italic mt-2 text-slate-600 leading-7">
          {company.legalName}<br />
          {company.address.line1}<br />
          {company.address.cityStateZip}<br />
          {company.address.country}
        </address>
      </div>
      <div>
        <h2 class="text-base font-semibold text-slate-900">Phone</h2>
        <p class="mt-2 text-slate-600 leading-7">
          <a href={`tel:${company.phone.href}`} class="hover:text-slate-900">
            {company.phone.display}
          </a>
        </p>
        <p class="mt-2 text-xs text-slate-500">
          Email is faster — most replies happen the same business day.
        </p>
      </div>
    </div>

    <p class="mt-12 text-xs text-slate-500">
      {product.name} is operated by {company.legalName}, an Illinois limited liability company (IL
      File Number {company.ilFileNumber}).
    </p>
  </section>
</BaseLayout>
