---
import { product } from "../data/product";
import { company } from "../data/company";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-5xl px-6 py-10 grid gap-8 md:grid-cols-3 text-sm text-slate-600">
    <div>
      <p class="font-semibold text-slate-900">{product.name}</p>
      <p class="mt-2 leading-6">
        {product.shortBlurb}
      </p>
      <p class="mt-3 text-xs text-slate-500">
        Made by{" "}
        <a
          class="underline hover:text-slate-900"
          href={company.websiteUrl}
          rel="noopener"
          target="_blank">{company.legalName}</a
        >
      </p>
    </div>

    <div>
      <p class="font-semibold text-slate-900">Help</p>
      <ul class="mt-2 space-y-1">
        <li><a class="hover:text-slate-900" href="/support">Support &amp; FAQ</a></li>
        <li><a class="hover:text-slate-900" href="/contact">Contact</a></li>
        <li>
          <a class="hover:text-slate-900" href={`mailto:${product.emails.support}`}>
            {product.emails.support}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-slate-900">Legal</p>
      <ul class="mt-2 space-y-1">
        <li><a class="hover:text-slate-900" href="/privacy">Privacy Policy</a></li>
        <li><a class="hover:text-slate-900" href="/terms">Terms of Service</a></li>
      </ul>
      <address class="mt-4 not-italic text-xs text-slate-500 leading-5">
        {company.legalName}<br />
        {company.address.line1}<br />
        {company.address.cityStateZip}
      </address>
    </div>
  </div>
  <div class="border-t border-slate-200">
    <div class="mx-auto max-w-5xl px-6 py-4 text-xs text-slate-500">
      © {year} {company.legalName}. {product.name} is a trademark of {company.legalName}. Not
      affiliated with any state Department of Motor Vehicles.
    </div>
  </div>
</footer>
