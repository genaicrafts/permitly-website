---
import { product, navItems } from "../data/product";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto max-w-5xl px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold text-slate-900">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-gradient-to-br from-indigo-600 to-violet-600 text-white text-sm font-bold tracking-tight"
        aria-hidden="true">P</span
      >
      <span>{product.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "transition-colors hover:text-slate-900",
                  isActive(item.href) ? "text-slate-900 font-medium" : "text-slate-600",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
